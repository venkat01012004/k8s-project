# Version control
.git
.gitignore
.github

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
venv/
env/
.venv/

# Environment / secrets
.env
.env.*

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Docs & misc
README.md
*.md
docs/

# Kubernetes manifests (not needed inside the image)
k8s/

# Local uploads (kept in volumes at runtime, not baked into image)
static/uploads/*
!static/uploads/**/.gitkeep

# Logs
*.log
